# This repo (the project root) intentionally does not track backend/ or
# frontend/ — each is its own separate git repository with its own
# history. See README.md's "Version control layout" section.
/backend/
/frontend/

# OS/editor noise
.DS_Store
Thumbs.db
*.swp

# Local scratch/output that shouldn't be committed at the root
/_to_delete/

# Real secrets for `docker compose --project-directory .` deployments
# (AUTH_TOKEN_ENCRYPTION_KEY, OAuth client secrets, Razorpay keys, etc. —
# see deploy/docker-compose.yml's `environment:` block and GO_LIVE.md).
# Never commit this.
/.env
.oracle-vm-key
.oracle-vm-key.pub
