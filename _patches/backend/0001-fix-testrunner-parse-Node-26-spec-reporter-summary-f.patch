From 3bee78e7d9888dc69c1aa90e88533902e9d28b1c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 11:04:38 +0000
Subject: [PATCH 1/3] fix(testrunner): parse Node 26 spec-reporter summary from
 node --test
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Node 26 prints the spec reporter ("ℹ pass 2") instead of TAP ("# pass 2")
when stdout is not a TTY, so parseNodeTestOutput returned null counts in the
node:26 Docker image. Accept both prefixes and add a unit test.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AcRWToNeMR3FSJbaVE45MG
---
 src/testrunner/parse.ts |  4 +++-
 test/testrunner.test.ts | 18 ++++++++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/testrunner/parse.ts b/src/testrunner/parse.ts
index de5077b..0ba6e4d 100644
--- a/src/testrunner/parse.ts
+++ b/src/testrunner/parse.ts
@@ -71,7 +71,9 @@ export function parseNodeTestOutput(rawOutput: string): TestCounts {
 }
 
 function matchTapCount(output: string, label: string): number | null {
-  const match = output.match(new RegExp(`^#\\s*${label}\\s+(\\d+)\\s*$`, "m"));
+  // TAP summary lines start with "#"; Node 26+ prints the "spec" reporter by
+  // default when stdout isn't a TTY, whose summary lines start with "ℹ".
+  const match = output.match(new RegExp(`^(?:#|ℹ)\\s*${label}\\s+(\\d+)\\s*$`, "m"));
   return match ? Number(match[1]) : null;
 }
 
diff --git a/test/testrunner.test.ts b/test/testrunner.test.ts
index d04f1f9..f3c09fc 100644
--- a/test/testrunner.test.ts
+++ b/test/testrunner.test.ts
@@ -270,6 +270,24 @@ describe("parseNodeTestOutput", () => {
     expect(parseNodeTestOutput(output)).toEqual({ passed: 2, failed: 1, skipped: 0 });
   });
 
+  it("parses the spec-reporter summary that Node 26+ prints by default (captured from a real run)", () => {
+    const output = [
+      "\u2714 passes (1.39ms)",
+      "\u2714 also passes (0.25ms)",
+      "\u2716 fails (10.36ms)",
+      "\u2139 tests 3",
+      "\u2139 suites 0",
+      "\u2139 pass 2",
+      "\u2139 fail 1",
+      "\u2139 cancelled 0",
+      "\u2139 skipped 0",
+      "\u2139 todo 0",
+      "\u2139 duration_ms 98.75",
+      "",
+    ].join("\n");
+    expect(parseNodeTestOutput(output)).toEqual({ passed: 2, failed: 1, skipped: 0 });
+  });
+
   it("counts cancelled tests as failed", () => {
     const output = ["# pass 4", "# fail 0", "# cancelled 1", "# skipped 0"].join("\n");
     expect(parseNodeTestOutput(output)).toEqual({ passed: 4, failed: 1, skipped: 0 });
-- 
