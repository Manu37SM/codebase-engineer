From aa13fddb85e2d87a5b07df2147c7079033d65dbb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 11:04:39 +0000
Subject: [PATCH 4/5] fix(auth): show Turnstile only when the server enforces
 it

Login/Register read the site key at import time and ignored the
turnstile flag returned by /auth/providers, so the two Turnstile tests failed
(also before any Dependabot change). Gate the widget on providers.turnstile and
read the site key at render time.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AcRWToNeMR3FSJbaVE45MG
---
 src/lib/api.ts         |  2 +-
 src/pages/Login.tsx    | 17 +++++++++++------
 src/pages/Register.tsx | 17 +++++++++++------
 3 files changed, 23 insertions(+), 13 deletions(-)

diff --git a/src/lib/api.ts b/src/lib/api.ts
index 9589890..de22b31 100644
--- a/src/lib/api.ts
+++ b/src/lib/api.ts
@@ -566,7 +566,7 @@ export function getGitHubSignInUrl(): string {
   return "/api/v1/auth/github/start";
 }
 
-export function getAuthProviders(): Promise<{ google: boolean; github: boolean }> {
+export function getAuthProviders(): Promise<{ google: boolean; github: boolean; turnstile: boolean }> {
   return request("/api/v1/auth/providers");
 }
 
diff --git a/src/pages/Login.tsx b/src/pages/Login.tsx
index 8b2666c..b32ad66 100644
--- a/src/pages/Login.tsx
+++ b/src/pages/Login.tsx
@@ -4,7 +4,10 @@ import { ApiError, getAuthProviders, getGitHubSignInUrl, getGoogleSignInUrl, log
 import { useAuth } from "../context/AuthContext";
 import Turnstile from "../components/Turnstile";
 
-const TURNSTILE_SITE_KEY = (import.meta.env.VITE_TURNSTILE_SITE_KEY as string | undefined)?.trim() || undefined;
+// Read at render time, not import time, so it reflects the current env
+// (Vite still inlines it statically in production builds).
+const getTurnstileSiteKey = () =>
+  (import.meta.env.VITE_TURNSTILE_SITE_KEY as string | undefined)?.trim() || undefined;
 
 export default function LoginPage() {
   const { refresh } = useAuth();
@@ -13,13 +16,15 @@ export default function LoginPage() {
   const [password, setPassword] = useState("");
   const [error, setError] = useState<string | null>(null);
   const [submitting, setSubmitting] = useState(false);
-  const [providers, setProviders] = useState({ google: false, github: false });
+  const [providers, setProviders] = useState({ google: false, github: false, turnstile: false });
   const [turnstileToken, setTurnstileToken] = useState<string | null>(null);
+  // Show the widget only when the server enforces Turnstile AND this build has a site key.
+  const turnstileSiteKey = providers.turnstile ? getTurnstileSiteKey() : undefined;
 
   useEffect(() => {
     getAuthProviders()
       .then(setProviders)
-      .catch(() => setProviders({ google: false, github: false }));
+      .catch(() => setProviders({ google: false, github: false, turnstile: false }));
   }, []);
 
   async function handleSubmit(e: FormEvent) {
@@ -70,9 +75,9 @@ export default function LoginPage() {
               onChange={(e) => setPassword(e.target.value)}
             />
           </div>
-          {TURNSTILE_SITE_KEY && (
+          {turnstileSiteKey && (
             <Turnstile
-              siteKey={TURNSTILE_SITE_KEY}
+              siteKey={turnstileSiteKey}
               onVerify={setTurnstileToken}
               onExpire={() => setTurnstileToken(null)}
             />
@@ -80,7 +85,7 @@ export default function LoginPage() {
           {error && <p className="text-sm text-red-600 dark:text-red-400">{error}</p>}
           <button
             type="submit"
-            disabled={submitting || (Boolean(TURNSTILE_SITE_KEY) && !turnstileToken)}
+            disabled={submitting || (Boolean(turnstileSiteKey) && !turnstileToken)}
             className="w-full rounded bg-slate-900 px-3 py-2 text-sm font-medium text-white disabled:opacity-50 dark:bg-slate-100 dark:text-slate-900"
           >
             {submitting ? "Signing in…" : "Sign in"}
diff --git a/src/pages/Register.tsx b/src/pages/Register.tsx
index b291773..45b3581 100644
--- a/src/pages/Register.tsx
