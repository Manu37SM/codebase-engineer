From 9a8c43eae10ec87dfc2daabdbec67f1989868f9e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 11:04:39 +0000
Subject: [PATCH] ci: add Docker image build workflow

Fixes Dependabot's github_actions job (no workflow files) and checks that
deploy/Dockerfile builds from all three repos.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AcRWToNeMR3FSJbaVE45MG
---
 .github/workflows/docker.yml | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)
 create mode 100644 .github/workflows/docker.yml

diff --git a/.github/workflows/docker.yml b/.github/workflows/docker.yml
new file mode 100644
index 0000000..0820b24
--- /dev/null
+++ b/.github/workflows/docker.yml
@@ -0,0 +1,31 @@
+name: Docker image
+
+on:
+  push:
+    branches: [master]
+  pull_request:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: docker-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build:
+    name: Build deploy image
+    runs-on: ubuntu-latest
+    steps:
+      # backend/ and frontend/ are separate repos (gitignored here), so the
+      # Dockerfile's build context has to be assembled from all three.
+      - uses: actions/checkout@v4
+      - uses: actions/checkout@v4
+        with:
+          repository: Manu37SM/codebase-engineer-backend
+          path: backend
+      - uses: actions/checkout@v4
+        with:
+          repository: Manu37SM/codebase-engineer-frontend
+          path: frontend
+      - run: docker build -f deploy/Dockerfile -t codebase-engineer:ci .
-- 
