

[Unit]
Description=Codebase Engineer (local-first developer platform)
After=network.target

[Service]
Type=simple

WorkingDirectory=%h/codebase-engineer/backend

ExecStart=/usr/bin/env node dist/server.js
Restart=on-failure
RestartSec=5
Environment=PORT=4000
Environment=HOST=127.0.0.1

[Install]
WantedBy=default.target
